{
  "name": "brsh",
  "version": "2.4.1",
  "description": "A unix like shell written in javascript",
  "main": "./dist/shell.min.js",
  "module": "./dist/shell.es.js",
  "exports": {
    ".": {
      "import": "./dist/shell.es.js",
      "require": "./dist/shell.min.js",
      "default": "./dist/shell.min.js"
    },
    "./terminal": {
      "import": "./dist/terminal.es.js",
      "require": "./dist/terminal.min.js",
      "default": "./dist/terminal.min.js"
    }
  },
  "bin": {
    "exportFileSystem": "bin/exportFileSystem.js",
    "brsh": "bin/brsh-shell.js"
  },
  "scripts": {
    "start": "node bin/exportFileSystem.js ./demo/filesystem -o ./demo/fs.js -v fs && vite --config vite.config.js demo/",
    "build:demofs": "node bin/exportFileSystem.js ./demo/filesystem -o ./dist-demo/fs.js -v fs",
    "build:demo": "vite build --config vite.config.demo.js && npm run build:demofs",
    "build": "npm run build:shell && npm run build:terminal",
    "build:shell": "vite build --config vite.config.shell.js",
    "build:terminal": "vite build --config vite.config.terminal.js",
    "shell": "node bin/brsh-shell.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliotstocker/Brsh-JS.git"
  },
  "author": "Eliot Stocker",
  "license": "GPL-3.0",
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "semantic-release": "^25.0.3",
    "vite": "^8.0.10",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ansi_up": "git+https://github.com/eliotstocker/ansi_up.git",
    "ansi-colors": "^4.1.3",
    "command-line-args": "^6.0.1",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "string.prototype.matchall": "^4.0.12",
    "through2": "^4.0.2",
    "tmp": "^0.2.5"
  }
}
